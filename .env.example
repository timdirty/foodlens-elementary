# 公開網址（Vercel Preview 會自動提供；本機可不填）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase 校園雲端模式；完全不填時，Demo 仍可完整操作。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 僅供伺服器端資料保存期限清理使用；不可加 NEXT_PUBLIC_。
# 建議使用 Supabase 新式 secret key；舊專案亦支援 service_role key。
SUPABASE_SECRET_KEY=

# 伺服器端 OpenAI-compatible 影像分析；不可加 NEXT_PUBLIC_。
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_MODEL=
# 例：https://your-provider.example/v1
AI_BASE_URL=
